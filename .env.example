# Copie para .env e troque TODAS as senhas. Nunca commite o .env.
CM_ENV=dev
CM_LOG_LEVEL=INFO

# PostgreSQL — superusuário do container (só para bootstrap) e roles da aplicação
POSTGRES_DB=cloudmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
CM_OWNER_PASSWORD=change-me-owner      # dono do schema, usado só por migrations
CM_APP_PASSWORD=change-me-app          # usado por API/worker; sem BYPASSRLS

# Redis
REDIS_PASSWORD=change-me-redis

# Chaves geradas com:
#   docker compose run --rm --no-deps migrate python -m app.cli gen-keys >> .env
# CM_JWT_PRIVATE_KEY: assinatura dos access tokens (Ed25519). Sem ela, em dev a API usa
#   uma chave efêmera (todos deslogam a cada restart).
# CM_KEK: cifra os tokens dos clusters Proxmox (envelope encryption). FAÇA BACKUP:
#   sem ela as credenciais salvas não podem ser lidas. Sem KEK, cadastrar credencial
#   responde 503.
# CM_JWT_PRIVATE_KEY="..."
# CM_KEK=...

# Cookie de refresh com flag Secure. false só em dev (http://localhost).
CM_COOKIE_SECURE=false
