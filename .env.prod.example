# Produção (docker-compose-prod.yaml). Copie para .env.prod, troque TUDO e guarde uma
# cópia num cofre: CM_KEK e CM_JWT_PRIVATE_KEY não podem ser recriados.
# Valores com $ vão entre aspas simples (o compose interpreta $ nas outras formas).

# Imagens (pipeline images): sha-<commit> ou a versão de uma tag v1.2.3
CM_IMAGE_TAG=sha-8f3236c
# CM_REGISTRY=us-central1-docker.pkg.dev/atena-cloud/acloud

# Domínio público (DNS apontando para esta VM, portas 80 e 443 abertas) e conta Let's Encrypt
CM_DOMAIN=cloud.atena.io
ACME_EMAIL=support@atena.io

# PostgreSQL (container postgres). As senhas entram em URLs de conexão: use só letras e
# números (ex.: `openssl rand -hex 24`). Mudar depois do primeiro `up` não altera as roles
# já criadas: troque também no banco (ALTER ROLE ... PASSWORD).
POSTGRES_DB=cloudmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-superusuario
CM_OWNER_PASSWORD=troque-owner         # dono do schema, só migrations
CM_APP_PASSWORD=troque-app             # API/worker; sem BYPASSRLS

# Redis local (sem persistência)
REDIS_PASSWORD=troque-por-uma-senha-longa

# Gere com:
#   docker run --rm us-central1-docker.pkg.dev/atena-cloud/acloud/cloud-manager-backend:<tag> python -m app.cli gen-keys
CM_JWT_PRIVATE_KEY="..."
CM_KEK=...

# E-mail (iRedMail)
CM_SMTP_HOST=mail.atena.io
CM_SMTP_PORT=587
CM_SMTP_TLS=starttls
CM_SMTP_USERNAME=no-reply@atena.io
CM_SMTP_PASSWORD='senha'
CM_SMTP_FROM=Cloud Manager <no-reply@atena.io>

# Opcionais
# CM_LOG_LEVEL=INFO
# CM_IPAM_MYSQL_URL=mysql://cloudmgr:<senha>@console.awf.atena.io:3306/awf_cloud
